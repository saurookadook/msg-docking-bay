{
    "components": {
        "schemas": {
            "HealthCheckResponse": {
                "description": "The health check's envelope.",
                "properties": {
                    "data": {
                        "$ref": "#/components/schemas/HealthCheckStatus"
                    }
                },
                "required": ["data"],
                "title": "HealthCheckResponse",
                "type": "object"
            },
            "HealthCheckStatus": {
                "description": "The state the health check reports.",
                "properties": {
                    "status": {
                        "const": "ok",
                        "title": "Status",
                        "type": "string"
                    }
                },
                "required": ["status"],
                "title": "HealthCheckStatus",
                "type": "object"
            },
            "HomeInfo": {
                "description": "What the homepage says about the API.",
                "properties": {
                    "message": {
                        "title": "Message",
                        "type": "string"
                    },
                    "name": {
                        "title": "Name",
                        "type": "string"
                    }
                },
                "required": ["message", "name"],
                "title": "HomeInfo",
                "type": "object"
            },
            "HomeResponse": {
                "description": "The homepage's envelope.",
                "properties": {
                    "data": {
                        "$ref": "#/components/schemas/HomeInfo"
                    }
                },
                "required": ["data"],
                "title": "HomeResponse",
                "type": "object"
            }
        }
    },
    "info": {
        "title": "FastAPI",
        "version": "0.1.0"
    },
    "openapi": "3.1.0",
    "paths": {
        "/api": {
            "get": {
                "description": "Return the API's name and a welcome message.\n\nThe body is static for now: it calls nothing and writes nothing.",
                "operationId": "read_home",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HomeResponse"
                                }
                            }
                        },
                        "description": "Successful Response"
                    }
                },
                "summary": "Read Home"
            }
        },
        "/api/health-check": {
            "get": {
                "description": "Report that the process is up.\n\nTouches nothing else (no database, no upstream call), so platform\nhealth checks stay cheap (FAPI-3).",
                "operationId": "read_health_check",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HealthCheckResponse"
                                }
                            }
                        },
                        "description": "Successful Response"
                    }
                },
                "summary": "Read Health Check"
            }
        }
    }
}
