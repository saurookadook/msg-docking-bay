{
    "name": "@app/frontend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -b && vite build",
        "build-storybook": "storybook build",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint --type-aware",
        "lint:fix": "oxlint --type-aware --fix",
        "start:dev": "vite",
        "storybook": "storybook dev -p 6006",
        "test": "vitest run",
        "test:cov": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc -b --noEmit"
    },
    "dependencies": {
        "classnames": "^2.5.1",
        "loglevel": "^1.9.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.0"
    },
    "devDependencies": {
        "@storybook/react-vite": "^10.6.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.5",
        "autoprefixer": "^10.6.1",
        "cssnano": "^9.9.0",
        "jsdom": "^30.1.3",
        "miragejs": "^0.1.48",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "oxlint-tsgolint": "^7.0.2005",
        "postcss-import": "^17.0.1",
        "postcss-preset-env": "^11.6.1",
        "storybook": "^10.6.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.11.2"
}
