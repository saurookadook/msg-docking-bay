{
    "name": "@app/frontend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "api:generate": "uv --directory ../backend run python -m scripts.export_openapi ../frontend/src/api/generated/openapi.json && pnpm --filter @app/api-codegen exec openapi-typescript ../../src/api/generated/openapi.json -o ../../src/api/generated/api.ts && oxfmt src/api/generated",
        "build": "tsc -b && vite build",
        "build-storybook": "storybook build",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint --type-aware",
        "lint:fix": "oxlint --type-aware --fix",
        "start:dev": "vite",
        "storybook": "storybook dev -p 6006",
        "test": "vitest run",
        "test:cov": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc -b --noEmit"
    },
    "dependencies": {
        "@tanstack/react-table": "^9.3.1",
        "classnames": "^2.5.1",
        "loglevel": "^1.9.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1"
    },
    "devDependencies": {
        "@storybook/react-vite": "^10.6.7",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.12",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^5.1.0",
        "autoprefixer": "^10.6.2",
        "cssnano": "^9.9.0",
        "jsdom": "^30.1.2",
        "miragejs": "^0.1.48",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0",
        "oxlint-tsgolint": "^7.0.2007",
        "postcss-import": "^17.0.1",
        "postcss-preset-env": "^11.6.2",
        "storybook": "^10.6.7",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.11.2"
}
