{
    //---------------------  AI Co-Authors  -------------------------
    // Co-Authored-By: Claude <noreply@anthropic.com>
    // Co-authored-by: Copilot <copilot@github.com>
    //----------------------------------------------------------------
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnType": false, // required
    "editor.formatOnPaste": false, // optional
    "editor.formatOnSave": true, // optional
    "editor.formatOnSaveMode": "file", // required to format on save
    // "files.autoSave": "onFocusChange", // optional but recommended
    "editor.tabSize": 2,
    // ------ Linting and formatting (Oxc extension; configs are ./frontend/.oxlintrc.json and ./frontend/.oxfmtrc.json)
    "eslint.enable": false,
    "oxc.enable.oxlint": true,
    "oxc.enable.oxfmt": true,
    "oxc.fmt.configPath": "./frontend/.oxfmtrc.json", // apply the frontend config to every file in the workspace
    "oxc.requireConfig": true,
    // "oxc.path.node": "${userHome}/.nvm/versions/node/v22.23.2/bin/node",
    "oxc.path.oxfmt": "frontend/node_modules/oxfmt/dist/cli.js",
    "oxc.path.oxlint": "frontend/node_modules/oxlint/dist/cli.js",
    "path-autocomplete.pathMappings": {
        "@": "${folder}/frontend/src"
    },
    "[typescriptreact]": {
        "editor.tabSize": 2
    },
    // ------ CSS
    "[css]": {
        "editor.tabSize": 2
    },
    "[scss]": {
        "editor.tabSize": 2
    },
    // ------ Python (Ruff extension formats and lints, reading backend/pyproject.toml)
    "[python]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "ruff.importStrategy": "fromEnvironment", // the locked Ruff in backend/.venv, as CI runs it
    "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
    // Pylance reads [tool.pyright] only from a pyproject.toml at the workspace root, so
    // mirror backend/pyproject.toml's table here and keep the two in sync (PY-9).
    "python.analysis.extraPaths": [
        "./backend"
    ],
    "python.analysis.typeCheckingMode": "strict",
    "python.analysis.diagnosticSeverityOverrides": {
        "reportImplicitOverride": "error",
        "reportUnnecessaryTypeIgnoreComment": "error"
    },
    "[sql]": {
        "editor.formatOnSave": false
    },
    // ------ JSON
    "json.schemaDownload.trustedDomains": {
        "https://schemastore.azurewebsites.net/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://www.schemastore.org/": true,
        "https://json.schemastore.org/": true,
        "https://json-schema.org/": true,
        "https://developer.microsoft.com/json-schemas/": true,
        "https://railway.com/railway.schema.json": true
    },
    "[json]": {
        "editor.tabSize": 4
    },
    "[jsonc]": {
        "editor.tabSize": 4
    },
    "[yaml]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 2
    },
    "[yml]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 2
    }
}
