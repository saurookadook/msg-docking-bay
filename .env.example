# Copy to .env (scripts/setup-local.sh does this). Every variable the stack reads is
# listed here (ENV-1). Secrets are never set here: the database passwords are files
# under .docker/secrets/, generated by scripts/setup-local.sh (ENV-13).

# App
APP_DOMAIN=msg-docking-bay.dev
ENVIRONMENT=dev
LOG_LEVEL=DEBUG

# Proxy: the host address and ports it publishes (ENV-12). 127.0.0.1 keeps the stack on
# this machine. 0.0.0.0 opens it to your network (needed to use 80/443 without Docker
# Desktop's "Allow privileged port mapping" setting). With ports other than 80/443, the
# app is at https://APP_DOMAIN:PROXY_HTTPS_PORT.
PROXY_BIND_ADDRESS=127.0.0.1
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Frontend
FRONTEND_HOST=frontend
FRONTEND_PORT=5173

# Backend
BACKEND_HOST=backend
UVICORN_PORT=8000
UVICORN_WORKERS=1
# Only the proxy can reach the backend on the Compose network; it publishes no port.
UVICORN_FORWARDED_ALLOW_IPS=*
UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=20

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=app
DATABASE_USER=app
DATABASE_OWNER_USER=app_owner
LOG_SQL=false
