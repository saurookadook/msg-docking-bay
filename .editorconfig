# Matches frontend/.oxfmtrc.json and Ruff, so moon's config syncs don't fight the
# formatters (MLANG-7).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.json]
indent_size = 4

[*.css]
indent_size = 4

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

# `caddy fmt` indents with tabs, and `caddy validate` warns about anything else.
[Caddyfile]
indent_style = tab
